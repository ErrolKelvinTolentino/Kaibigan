# Public Flutter client configuration. Copy this file to .env and run with:
# dart run tool/run_with_env.dart --web-port=3000
# Chrome is the default. Set this to windows, edge, or another Flutter device ID.
FLUTTER_DEVICE=chrome
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
# Optional. Web defaults to the current origin + /auth-callback; Android/iOS
# default to com.kaibigan.app://auth-callback.
PASSWORD_RESET_REDIRECT_URL=
OAUTH_REDIRECT_URL=
ENABLE_GOOGLE_AUTH=false

# Demo AI configuration. The local runner compiles these into the app so they
# are recoverable from a web/mobile build. Use only for local demonstrations;
# move them to Supabase Edge Function secrets before publishing the app.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
