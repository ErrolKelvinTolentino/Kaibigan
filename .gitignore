# =================================================================
# ENVIRONMENT & SENSITIVE KEYS (DO NOT COMMIT API KEYS)
# =================================================================
.env
.env.*
!.env.example
*.pem
*.key

# =================================================================
# FLUTTER & DART BUILD ARTIFACTS
# =================================================================
**/build/
**/.dart_tool/
**/.pub/
**/.pub-cache/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/pubspec.lock.bak

# =================================================================
# ANDROID BUILD & GRADLE
# =================================================================
**/android/.gradle/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/key.jks
**/android/key.p12
**/android/app/google-services.json

# =================================================================
# IOS & MACOS
# =================================================================
**/ios/Runner.xcworkspace/
**/ios/Pods/
**/ios/Podfile.lock
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/.symlinks/
**/ios/DerivedData/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
*.dSYM

# =================================================================
# WINDOWS & WEB BUILD OUTPUT
# =================================================================
**/windows/flutter/ephemeral/
**/web/main.dart.js
**/web/main.dart.js.map
**/web/main.dart.js.deps

# =================================================================
# IDES & EDITORS
# =================================================================
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo

# =================================================================
# OS & SYSTEM FILES
# =================================================================
.DS_Store
.DS_Store?
._*
.Trashes
ehthumbs.db
Thumbs.db

# =================================================================
# LOGS & CRASH REPORTS
# =================================================================
*.log
*.crash
