# Copy these entries into ../.env.local for local function development.
# Keep real provider keys out of git and out of the Flutter app bundle.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides. These defaults are production-stable model IDs.
GEMINI_MODEL=gemini-2.5-flash
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
